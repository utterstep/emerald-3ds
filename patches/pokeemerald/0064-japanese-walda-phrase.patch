 // Attempts to generate a wallpaper based on the given trainer id and phrase.
 // Returns TRUE if successful and sets the wallpaper results to the given pointers.
@@ -147,6 +153,19 @@ static bool32 TryCalculateWallpaper(u16 *backgroundClr, u16 *foregroundClr, u8 *
     u8 charsByTableId[WALDA_PHRASE_LENGTH];
     u16 *ptr;
 
+#if GAME_LANGUAGE == LANGUAGE_JAPANESE
+    // The Japanese ROM takes any 12 characters, with no letter table: each one's
+    // code minus 1 gives its low 6 bits, and the 12 x 6 bits fill the 72 bits of
+    // the data array, so no bits are left to check.
+    if (StringLength(phrase) != WALDA_PHRASE_ENTRY_LENGTH)
+        return FALSE;
+
+    for (i = 0; i < WALDA_PHRASE_ENTRY_LENGTH; i++)
+        charsByTableId[i] = phrase[i] - 1;
+
+    for (i = 0; i < WALDA_PHRASE_ENTRY_LENGTH; i++)
+        SetWallpaperDataFromLetter(data, charsByTableId, 6 * i, 2 + 8 * i, 6);
+#else
     // Reject any phrase that does not use the full length
     if (StringLength(phrase) != WALDA_PHRASE_LENGTH)
         return FALSE;
@@ -173,6 +192,7 @@ static bool32 TryCalculateWallpaper(u16 *backgroundClr, u16 *foregroundClr, u8 *
     // Reject the phrase if they are not already the same
     if (GetWallpaperDataBits(data, 0, 3) != GetWallpaperDataBits(charsByTableId, TO_BIT_OFFSET(WALDA_PHRASE_LENGTH - 1) + 2, 3))
         return FALSE;
+#endif
 
     // Perform some relatively arbitrary changes to the wallpaper data using the last byte (KEY)
     RotateWallpaperDataLeft(data, NUM_WALLPAPER_DATA_BYTES,     21);
@@ -264,6 +284,7 @@ static void SetWallpaperDataFromLetter(u8 *data, u8 *letterTableIds, u32 setOffs
     }
 }
 
+#if GAME_LANGUAGE != LANGUAGE_JAPANESE
 static u32 GetWallpaperDataBits(u8 *data, u32 offset, u32 numBits)
 {
     u32 bits, i;
@@ -276,3 +297,4 @@ static u32 GetWallpaperDataBits(u8 *data, u32 offset, u32 numBits)
 
     return bits;
 }
+#endif
