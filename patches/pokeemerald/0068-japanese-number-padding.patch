+// 0x77 is a kana in the Japanese charset: that ROM pads numbers and fields with
+// its space instead. (tools/preproc includes this file without GAME_LANGUAGE.)
+#if defined(GAME_LANGUAGE) && GAME_LANGUAGE == LANGUAGE_JAPANESE
+#define CHAR_SPACER            CHAR_SPACE
+#else
 #define CHAR_SPACER            0x77 // Empty space
+#endif
 //
