index 5ddd400..8453bec 100644
--- a/src/menu.c
+++ b/src/menu.c
@@ -1723,7 +1723,11 @@ void CreateYesNoMenu(const struct WindowTemplate *window, u16 baseTileNum, u8 pa
     printer.windowId = sYesNoWindowId;
     printer.fontId = FONT_NORMAL;
     printer.x = 8;
+#if GAME_LANGUAGE == LANGUAGE_JAPANESE
+    printer.y = 2; // The Japanese ROM's, with its menu's top below
+#else
     printer.y = 1;
+#endif
     printer.currentX = printer.x;
     printer.currentY = printer.y;
     printer.fgColor = GetFontAttribute(FONT_NORMAL, FONTATTR_COLOR_FOREGROUND);
@@ -1734,7 +1738,11 @@ void CreateYesNoMenu(const struct WindowTemplate *window, u16 baseTileNum, u8 pa
     printer.lineSpacing = 0;
 
     AddTextPrinter(&printer, TEXT_SKIP_DRAW, NULL);
+#if GAME_LANGUAGE == LANGUAGE_JAPANESE
+    InitMenuNormal(sYesNoWindowId, FONT_NORMAL, 0, 2, GetFontAttribute(FONT_NORMAL, FONTATTR_MAX_LETTER_HEIGHT), 2, initialCursorPos);
+#else
     InitMenuInUpperLeftCornerNormal(sYesNoWindowId, 2, initialCursorPos);
+#endif
 }
 
