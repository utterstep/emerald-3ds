+static u32 GetShortJapaneseGlyphWidth(u16 glyphId)
+{
+#if GAME_LANGUAGE == LANGUAGE_JAPANESE
+    // The Japanese ROM's width table gives the small tsu (hiragana and katakana) 9
+    // pixels; the international table gives them 10.
+    if (glyphId == 0x50 || glyphId == 0xA0)
+        return 9;
+#endif
+    return gFontShortJapaneseGlyphWidths[glyphId];
