 static void TrainerHillDummy(void)
 {
-
+#if GAME_LANGUAGE == LANGUAGE_JAPANESE
+    // The Japanese ROM keeps one best time, for the challenge whose id
+    // (challenge.unused1) the save holds: another challenge starts it again,
+    // with its prize (there are no per-mode times to take it from).
+    if (gSaveBlock1Ptr->trainerHill.unused != sHillData->challenge.unused1)
+    {
+        gSaveBlock1Ptr->trainerHill.unused = sHillData->challenge.unused1;
+        SetTimerValue(&gSaveBlock1Ptr->trainerHill.bestTime, HILL_MAX_TIME);
+        gSaveBlock1Ptr->trainerHill.receivedPrize = FALSE;
+        gSaveBlock2Ptr->frontier.unk_EF9 = 0;
+    }
+#endif
 }
 
+#if GAME_LANGUAGE == LANGUAGE_JAPANESE
+static const u8 sText_ClassDashes[] = _("---------");
+static const u8 sText_NameDashes[] = _("-----");
+
+// The Japanese board: no modes, so the best time of the one challenge, under
+// each floor and its two trainers, who stay dashes until the challenge has
+// been cleared.
+void PrintOnTrainerHillRecordsWindow(void)
+{
+    s32 i, j, y, numFloors;
+    u32 total, minutes, secondsWhole, secondsFraction;
+    bool32 cleared;
+
+    SetUpDataStruct();
+    FillWindowPixelBuffer(0, PIXEL_FILL(0));
+    TrainerHillDummy();
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 68, 0, sRecordWinColors, TEXT_SKIP_DRAW, gText_TimeBoard);
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 0, 120, sRecordWinColors, TEXT_SKIP_DRAW, gText_TimeCleared);
+
+    total = GetTimerValue(&gSaveBlock1Ptr->trainerHill.bestTime);
+    cleared = (total != HILL_MAX_TIME);
+    minutes = total / (60 * 60);
+    total %= (60 * 60);
+    ConvertIntToDecimalStringN(gStringVar1, minutes, STR_CONV_MODE_RIGHT_ALIGN, 2);
+    secondsWhole = total / 60;
+    total %= 60;
+    ConvertIntToDecimalStringN(gStringVar2, secondsWhole, STR_CONV_MODE_RIGHT_ALIGN, 2);
+    secondsFraction = (total * 168) / 100;
+    ConvertIntToDecimalStringN(gStringVar3, secondsFraction, STR_CONV_MODE_LEADING_ZEROS, 2);
+    StringExpandPlaceholders(gStringVar4, gText_XMinYDotZSec);
+    AddTextPrinterParameterized3(0, FONT_NORMAL, 48, 132, sRecordWinColors, TEXT_SKIP_DRAW, gStringVar4);
+
+    if (gSaveBlock2Ptr->frontier.savedGame)
+        numFloors = sHillData->challenge.numFloors;
+    else
+        numFloors = NUM_TRAINER_HILL_FLOORS_JP;
+    for (i = 0; i < numFloors; i++)
+    {
+        AddTextPrinterParameterized3(0, FONT_NORMAL, 12, 14 + 26 * i, sRecordWinColors, TEXT_SKIP_DRAW, sFloorStrings[i]);
+        for (j = 0; j < HILL_TRAINERS_PER_FLOOR; j++)
+        {
+            const struct TrainerHillTrainer *trainer = &sHillData->floors[i].trainers[j];
+
+            y = 14 + 13 * (HILL_TRAINERS_PER_FLOOR * i + j);
+            if (gSaveBlock2Ptr->frontier.savedGame && cleared)
+            {
+                AddTextPrinterParameterized3(0, FONT_NORMAL, 36, y, sRecordWinColors, TEXT_SKIP_DRAW,
+                                             gTrainerClassNames[gFacilityClassToTrainerClass[trainer->facilityClass]]);
+                AddTextPrinterParameterized3(0, FONT_NORMAL, 144, y, sRecordWinColors, TEXT_SKIP_DRAW, trainer->name);
+            }
+            else
+            {
+                AddTextPrinterParameterized3(0, FONT_NORMAL, 36, y, sRecordWinColors, TEXT_SKIP_DRAW, sText_ClassDashes);
+                AddTextPrinterParameterized3(0, FONT_NORMAL, 144, y, sRecordWinColors, TEXT_SKIP_DRAW, sText_NameDashes);
+            }
+        }
+    }
+
+    PutWindowTilemap(0);
+    CopyWindowToVram(0, COPYWIN_FULL);
+    FreeDataStruct();
+}
