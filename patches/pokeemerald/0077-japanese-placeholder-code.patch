+    AddTextPrinterParameterized3(WIN_CARD_TEXT, FONT_NORMAL, xOffsets[sData->isHoenn], STAT_Y(top), sTrainerCardTextColors, TEXT_SKIP_DRAW, statName);
+}
+
+static void PrintStatOnBackOfCard(u8 top, const u8 *statName, u8 *stat, const u8 *color)
