Emerald 3DS changes to pret/pokeemerald 76463dac15cad36aca5e2b3f6366abf9e53f814f: the OPTION screen's box on a 3DS screen
Applies after 0084-reading-pane-hooks.patch; apply with tools/bootstrap.py.

The GBA draws the options box's side edges three rows past its bottom
corners, below its 160 lines; the 3DS's 240 show them hanging under the
box. And it highlights the chosen row to DISPLAY_WIDTH - 16, which on the
3DS is 384: the highlight covers the box's right edge on that row. On the
3DS the edges stop at the corners and the highlight at the box's own edge,
as the GBA shows them.

--- a/src/option_menu.c
+++ b/src/option_menu.c
@@ -373,7 +373,13 @@ static void Task_OptionMenuFadeOut(u8 taskId)
 
 static void HighlightOptionMenuItem(u8 index)
 {
+#ifdef PLATFORM_3DS
+    // The box's own width: DISPLAY_WIDTH is the 3DS's 400 here, and a highlight
+    // that wide hides the box's right edge on the chosen row.
+    SetGpuReg(REG_OFFSET_WIN0H, WIN_RANGE(16, 240 - 16));
+#else
     SetGpuReg(REG_OFFSET_WIN0H, WIN_RANGE(16, DISPLAY_WIDTH - 16));
+#endif
     SetGpuReg(REG_OFFSET_WIN0V, WIN_RANGE(index * 16 + 40, index * 16 + 56));
 }
 
@@ -658,8 +664,15 @@ static void DrawBgWindowFrames(void)
     FillBgTilemapBufferRect(1, TILE_TOP_CORNER_L,  1,  4,  1,  1,  7);
     FillBgTilemapBufferRect(1, TILE_TOP_EDGE,      2,  4, 26,  1,  7);
     FillBgTilemapBufferRect(1, TILE_TOP_CORNER_R, 28,  4,  1,  1,  7);
+#ifdef PLATFORM_3DS
+    // Down to the box's bottom corners: the GBA's edges run three rows on, past
+    // its 160 lines, where the 3DS's 240 show them.
+    FillBgTilemapBufferRect(1, TILE_LEFT_EDGE,     1,  5,  1, 14,  7);
+    FillBgTilemapBufferRect(1, TILE_RIGHT_EDGE,   28,  5,  1, 14,  7);
+#else
     FillBgTilemapBufferRect(1, TILE_LEFT_EDGE,     1,  5,  1, 18,  7);
     FillBgTilemapBufferRect(1, TILE_RIGHT_EDGE,   28,  5,  1, 18,  7);
+#endif
     FillBgTilemapBufferRect(1, TILE_BOT_CORNER_L,  1, 19,  1,  1,  7);
     FillBgTilemapBufferRect(1, TILE_BOT_EDGE,      2, 19, 26,  1,  7);
     FillBgTilemapBufferRect(1, TILE_BOT_CORNER_R, 28, 19,  1,  1,  7);
