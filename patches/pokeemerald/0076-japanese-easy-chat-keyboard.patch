+#if GAME_LANGUAGE == LANGUAGE_JAPANESE
+// The Japanese phrase is a tile a character: the cursor goes past the earlier words
+// and their two spaces, 5 tiles for an empty word (PrintCurrentPhrase)
+static bool8 UpdateMainCursor(void)
+{
+    u8 i;
+    u16 *ecWord;
+    u8 frameId;
+    u8 cursorColumn, cursorRow;
+    u16 x;
+
+    ecWord = GetCurrentPhrase();
+    frameId = GetEasyChatScreenFrameId();
+    cursorColumn = GetMainCursorColumn();
+    cursorRow = GetMainCursorRow();
+    ecWord += cursorRow * GetNumColumns();
+    x = sPhraseFrameDimensions[frameId].left + 1;
+    for (i = 0; i < cursorColumn; i++)
+    {
+        if (*ecWord == EC_EMPTY_WORD)
+            x += 5 + 2;
+        else
+            x += GetEasyChatWordStringLength(*ecWord) + 2;
+        ecWord++;
+    }
+
+    SetMainCursorPos(x * 8 + 4, (sPhraseFrameDimensions[frameId].top + cursorRow * 2) * 8 + 8);
+    return FALSE;
+}
