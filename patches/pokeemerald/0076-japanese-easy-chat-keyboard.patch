+#if GAME_LANGUAGE == LANGUAGE_JAPANESE
+// gEasyChatWordsByLetterPointers: 0 is the others (そのた), 1-44 the kana rows あ to わ
+static int GetSelectedAlphabetGroupId(void)
+{
+    int column = sEasyChatScreen->keyboardColumn;
+    int row = sEasyChatScreen->keyboardRow;
+
+    if (column < 5)
+        return row * 5 + column + 1;   // あ-と
+    if (column < 10)
+    {
+        if (row < 3)
+            return row * 5 + column + 16;  // な-も
+        return column + 34;             // ら-ろ
+    }
+    if (column < 13)
+    {
+        if (row == 0)
+            return column + 26;         // や-よ
+        return 0;                       // そのた
+    }
+    return 44;                          // わ
+}
+#else
 static int GetSelectedAlphabetGroupId(void)
 {
     int column = (u8)sEasyChatScreen->keyboardColumn < NUM_ALPHABET_COLUMNS ? sEasyChatScreen->keyboardColumn : 0;
     int row = (u8)sEasyChatScreen->keyboardRow < NUM_ALPHABET_ROWS ? sEasyChatScreen->keyboardRow : 0;
     return sAlphabetGroupIdMap[row][column];
 }
+#endif
 
