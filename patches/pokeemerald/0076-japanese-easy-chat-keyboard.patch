+#if GAME_LANGUAGE == LANGUAGE_JAPANESE
+// One sprite: the Japanese cursor graphics hold whole rectangles, not mirrored halves
+static void CreateRectangleCursorSprites(void)
+{
+    u8 spriteId = CreateSprite(&sSpriteTemplate_RectangleCursor, 0, 0, 3);
+    sScreenControl->rectangleCursorSpriteRight = &gSprites[spriteId];
+    UpdateRectangleCursorPos();
+}
+
+static void DestroyRectangleCursorSprites(void)
+{
+    DestroySprite(sScreenControl->rectangleCursorSpriteRight);
+    sScreenControl->rectangleCursorSpriteRight = NULL;
+}
+
+static void UpdateRectangleCursorPos(void)
+{
+    s8 column;
+    s8 row;
+
+    if (sScreenControl->rectangleCursorSpriteRight)
+    {
+        GetKeyboardCursorColAndRow(&column, &row);
+        if (!GetInAlphabetMode())
+            SetRectangleCursorPos_GroupMode(column, row);
+        else
+            SetRectangleCursorPos_AlphabetMode(column, row);
+    }
+}
+
+static void SetRectangleCursorPos_GroupMode(s8 column, s8 row)
+{
+    struct Sprite *cursor = sScreenControl->rectangleCursorSpriteRight;
+
+    if (column != -1)
+    {
+        // In group name window
+        StartSpriteAnim(cursor, RECTCURSOR_ANIM_ON_GROUP);
+        cursor->x = column * 56 + 40;
+        cursor->y = row * 16 + 96;
+    }
+    else
+    {
+        // In button window
+        StartSpriteAnim(cursor, RECTCURSOR_ANIM_ON_BUTTON);
+        cursor->x = 216;
+        cursor->y = row * 16 + 112;
+    }
+}
+
+// The keys are the kana of the keyboard's rows of text, 8 pixels apart, a blank
+// between groups of five: column c is character c + c / 5 of its row
+static void SetRectangleCursorPos_AlphabetMode(s8 column, s8 row)
+{
+    struct Sprite *cursor = sScreenControl->rectangleCursorSpriteRight;
+
+    if (column == -1)
+    {
+        // In button window
+        StartSpriteAnim(cursor, RECTCURSOR_ANIM_ON_BUTTON);
+        cursor->x = 216;
+        cursor->y = row * 16 + 112;
+    }
+    else if (column == 10 && row == 1)
+    {
+        // Cursor is on そのた (others)
+        StartSpriteAnim(cursor, RECTCURSOR_ANIM_ON_OTHERS);
+        cursor->x = 124;
+        cursor->y = 112;
+    }
+    else
+    {
+        StartSpriteAnim(cursor, RECTCURSOR_ANIM_ON_LETTER);
+        cursor->x = (column + column / 5) * 8 + 20;
+        cursor->y = row * 16 + 96;
+        if (column > 12)
+            cursor->x += 8; // わ, after a blank
+    }
+}
+#else
 static void CreateRectangleCursorSprites(void)
 {
     u8 spriteId = CreateSprite(&sSpriteTemplate_RectangleCursor, 0, 0, 3);
