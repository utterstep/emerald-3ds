 static void DisplayDiplomaText(void)
 {
+#if GAME_LANGUAGE == LANGUAGE_JAPANESE
+    // The Japanese ROM's layout: its diploma text has no placeholders. The player's
+    // name, in the red of gText_DiplomaEmpty, goes between gJPText_Player and
+    // gJPText_Sama; the Pokédex's name over the text's indented first line.
+    u8 name[PLAYER_NAME_LENGTH + 8];
+
+    PrintDiplomaText((u8 *)gJPText_Player, 0, 2);
+    StringCopy_PlayerName(StringCopy(name, gText_DiplomaEmpty), gSaveBlock2Ptr->playerName);
+    PrintDiplomaText(name, 0x30, 2);
+    PrintDiplomaText((u8 *)gJPText_Sama, 0x58, 2);
+    PrintDiplomaText((u8 *)gText_PokedexDiploma, 0, 0x22);
+    if (HasAllMons())
+    {
+        SetGpuReg(REG_OFFSET_BG1HOFS, DISPLAY_WIDTH + 16);
+        PrintDiplomaText((u8 *)gText_DexNational, 0, 0x22);
+    }
+    else
+    {
+        SetGpuReg(REG_OFFSET_BG1HOFS, 0);
+        PrintDiplomaText((u8 *)gText_DexHoenn, 0, 0x22);
+    }
+    PrintDiplomaText((u8 *)gJPText_GameFreak, 0x30, 0x72);
+#else
     if (HasAllMons())
     {
         SetGpuReg(REG_OFFSET_BG1HOFS, DISPLAY_WIDTH + 16);
@@ -139,6 +168,7 @@ static void DisplayDiplomaText(void)
     }
     StringExpandPlaceholders(gStringVar4, gText_PokedexDiploma);
     PrintDiplomaText(gStringVar4, 0, 1);
+#endif
     PutWindowTilemap(0);
     CopyWindowToVram(0, COPYWIN_FULL);
 }
