+#ifdef PLATFORM_3DS
+// 3ds_reading.c: where a window's printer is in its text and what it waits
+// for, for the page the reading pane shows; FALSE once it is done.
+bool8 CtrText_Progress(u8 windowId, const u8 **currentChar, u8 *state)
+{
+    if (windowId >= WINDOWS_MAX || !sTextPrinters[windowId].active)
+        return FALSE;
+    *currentChar = sTextPrinters[windowId].printerTemplate.currentChar;
+    *state = sTextPrinters[windowId].state;
+    return TRUE;
+}
+#endif
