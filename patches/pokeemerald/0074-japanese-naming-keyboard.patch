+#if GAME_LANGUAGE == LANGUAGE_JAPANESE
+// Codes of the Japanese character set (charmap.txt): か-と, は-ほ and their katakana
+// take a dakuten, は-ほ, ば-ぼ and their katakana a handakuten; ぱ-ぽ lose theirs for a
+// dakuten and ば-ぼ theirs for a handakuten.
+static bool8 CanTakeDakuten(u8 ch)
+{
+    return (ch >= 0x06 && ch <= 0x14)  // か-と
+        || (ch >= 0x1A && ch <= 0x1E)  // は-ほ
+        || (ch >= 0x4B && ch <= 0x4F)  // ぱ-ぽ
+        || (ch >= 0x56 && ch <= 0x64)  // カ-ト
+        || (ch >= 0x6A && ch <= 0x6E)  // ハ-ホ
+        || (ch >= 0x9B && ch <= 0x9F); // パ-ポ
+}
+
+static bool8 CanTakeHandakuten(u8 ch)
+{
+    return (ch >= 0x1A && ch <= 0x1E)  // は-ほ
+        || (ch >= 0x46 && ch <= 0x4A)  // ば-ぼ
+        || (ch >= 0x6A && ch <= 0x6E)  // ハ-ホ
+        || (ch >= 0x96 && ch <= 0x9A); // バ-ボ
+}
+
+static u8 WithDakuten(u8 ch)
+{
+    if ((ch >= 0x06 && ch <= 0x14) || (ch >= 0x56 && ch <= 0x64))
+        return ch + 0x31; // が-ど, ガ-ド
+    if ((ch >= 0x1A && ch <= 0x1E) || (ch >= 0x6A && ch <= 0x6E))
+        return ch + 0x2C; // ば-ぼ, バ-ボ
+    if ((ch >= 0x4B && ch <= 0x4F) || (ch >= 0x9B && ch <= 0x9F))
+        return ch - 5;    // ば-ぼ, バ-ボ
+    return ch;
+}
+
+static u8 WithHandakuten(u8 ch)
+{
+    if ((ch >= 0x1A && ch <= 0x1E) || (ch >= 0x6A && ch <= 0x6E))
+        return ch + 0x31; // ぱ-ぽ, パ-ポ
+    if ((ch >= 0x46 && ch <= 0x4A) || (ch >= 0x96 && ch <= 0x9A))
+        return ch + 5;    // ぱ-ぽ, パ-ポ
+    return ch;
+}
+
+// The dakuten and handakuten keys change the last character; FALSE if it has no such form
+static bool8 AddDakuten(void)
+{
+    u8 index = GetPreviousTextCaretPosition();
+    u8 ch = sNamingScreen->textBuffer[index];
+
+    if (!CanTakeDakuten(ch))
+        return FALSE;
+    sNamingScreen->textBuffer[index] = WithDakuten(ch);
+    return TRUE;
+}
+
+static bool8 AddHandakuten(void)
+{
+    u8 index = GetPreviousTextCaretPosition();
+    u8 ch = sNamingScreen->textBuffer[index];
+
+    if (!CanTakeHandakuten(ch))
+        return FALSE;
+    sNamingScreen->textBuffer[index] = WithHandakuten(ch);
+    return TRUE;
+}
+
+static void CycleLastCharacter(void)
+{
+    u8 i;
+    u8 index = GetPreviousTextCaretPosition();
+    u8 ch = sNamingScreen->textBuffer[index];
+
+    for (i = 0; sCharCycleFrom[i] != EOS; i++)
+    {
+        if (ch == sCharCycleFrom[i])
+        {
+            sNamingScreen->textBuffer[index] = sCharCycleTo[i];
+            break;
+        }
+    }
+    DrawTextEntry();
+    CopyBgTilemapBufferToVram(3);
+    PlaySE(SE_SELECT);
+}
+#endif
